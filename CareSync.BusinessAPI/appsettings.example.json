{
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;port=3306;database=healthcare_db;user=YOUR_DB_USERNAME;password=YOUR_DB_PASSWORD;"
  },

  "Jwt": {
    "Issuer": "HealthcareManagementSystem",
    "Audience": "HealthcareUsers",
    "Secret": "YOUR_JWT_SECRET"
  },

  "Encryption": {
    "Key": "YOUR_32_CHARACTER_ENCRYPTION_KEY",
    "IV": "YOUR_16_CHARACTER_ENCRYPTION_IV"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
